# Proyek ini khusus Vercel + Supabase (PostgreSQL).
# Server-only PostgreSQL connection string from Supabase > Connect > Transaction Pooler.
# Add the real value as DATABASE_URL (Secret) in Vercel; never expose it with a VITE_ prefix.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:6543/postgres"

# Author login. Set these as server-only Environment Variables in Vercel.
ADMIN_EMAIL="fityorastoreoffice@gmail.com"
ADMIN_PASSWORD="SET_A_LONG_UNIQUE_PASSWORD_HERE"

# Optional comma-separated additional admin email allowlist.
# ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# Optional AI provider key, server-only.
GEMINI_API_KEY=""
# Opsional. Alamat situs untuk canonical/sitemap. Kosongkan saat memakai domain sementara .vercel.app
# (Vercel mengisinya otomatis). Isi dengan domain sendiri bila sudah ada, lalu deploy ulang.
# APP_URL="https://domain-anda.com"

# Optional: instant order notifications on the admin dashboard (Supabase Realtime Broadcast).
# Both values are PUBLIC (URL + publishable anon key). Never put the service_role key or DATABASE_URL here.
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_ANON_KEY=""
# SUPABASE_REALTIME_CHANNEL="fityora-orders-pulse"

# Optional hardening: PEM text of the Supabase SSL certificate (Supabase > Project Settings > Database > SSL).
# When set, the server verifies the database certificate. Paste it as one line, using \n between lines.
# DATABASE_SSL_CA=""

# Optional: notifikasi push ke HP Author saat ada pesanan baru (tanpa data pesanan di pesan push).
# Buat kunci dengan: node scripts/generate-vapid-keys.mjs  (VAPID_PRIVATE_KEY rahasia, server-only)
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:emailanda@contoh.com"
